{
  "name": "epp-sistema",
  "version": "1.0.0",
  "private": true,
  "description": "Gestion de EPP, Kardex y flujo comercial con SQLite",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "migrate": "tsx src/config/migrate.ts",
    "seed": "node seed.js",
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config frontend/vite.config.ts",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.8",
    "vitest": "^3.0.0"
  }
}
